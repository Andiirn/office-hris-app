## 4. Contoh Referensi Kode TypeScript Hook (`useAttendanceStatus.ts`)

```typescript
import { useState, useCallback } from 'react';
import { useFocusEffect } from '@react-navigation/native';
import { attendanceService } from '../services/attendance.service';
import { AttendanceItem } from '../types/attendance';

export type AttendanceState = 'LOADING' | 'NOT_CHECKED_IN' | 'CLOCKED_IN' | 'COMPLETED';

export function useAttendanceStatus() {
  const [state, setState] = useState<AttendanceState>('LOADING');
  const [activeRecord, setActiveRecord] = useState<AttendanceItem | null>(null);
  const [completedRecord, setCompletedRecord] = useState<AttendanceItem | null>(null);

  const fetchStatus = useCallback(async () => {
    setState('LOADING');
    try {
      // 1. Cek apakah ada Open Check-In (Checkin terisi, Checkout null)
      const openRecord = await attendanceService.getTodayRecord();
      
      if (openRecord && openRecord.checkin_at && !openRecord.checkout_at) {
        setActiveRecord(openRecord);
        setCompletedRecord(null);
        setState('CLOCKED_IN');
        return;
      }

      // 2. Jika open-checkin NULL, cek riwayat absensi hari ini (Apakah sudah checkout?)
      const todayStr = new Date().toISOString().split('T')[0];
      const todayHistory = await attendanceService.getAttendanceHistory({
        date_from: todayStr,
        date_to: todayStr,
        limit: 1,
      });

      const todayRecord = todayHistory[0];
      if (todayRecord && todayRecord.checkin_at && todayRecord.checkout_at) {
        setActiveRecord(null);
        setCompletedRecord(todayRecord);
        setState('COMPLETED');
        return;
      }

      // 3. Belum absen sama sekali hari ini
      setActiveRecord(null);
      setCompletedRecord(null);
      setState('NOT_CHECKED_IN');
    } catch (error) {
      console.error('Failed to fetch attendance status:', error);
      setState('NOT_CHECKED_IN');
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      fetchStatus();
    }, [fetchStatus])
  );

  return { state, activeRecord, completedRecord, refetchStatus: fetchStatus };
}
```

