## 5. Implementasi Guard Logika Scanner di UI (`ScannerButton.tsx`)

```typescript
import React from 'react';
import { Alert, TouchableOpacity, Text, View } from 'react-native';
import { useAttendanceStatus } from '../hooks/useAttendanceStatus';

export function ScanAttendanceWidget({ onOpenScanner }: { onOpenScanner: (mode: 'CHECK_IN' | 'CHECK_OUT') => void }) {
  const { state, activeRecord, completedRecord, state: loadingState } = useAttendanceStatus();

  const handlePressScan = () => {
    if (state === 'COMPLETED') {
      Alert.alert(
        'Presensi Hari Ini Selesai',
        '⚠️ Anda sudah melakukan Check-In dan Check-Out untuk hari ini. Terima kasih!',
        [{ text: 'Mengerti', style: 'default' }]
      );
      return;
    }

    if (state === 'CLOCKED_IN') {
      // Buka Scanner untuk Check-Out
      onOpenScanner('CHECK_OUT');
    } else {
      // Buka Scanner untuk Check-In
      onOpenScanner('CHECK_IN');
    }
  };

  if (loadingState === 'LOADING') {
    return <Text>Memuat status absensi...</Text>;
  }

  return (
    <View className="p-4 border rounded-xl bg-card">
      {/* Informative Status Text */}
      <Text className="font-bold text-lg mb-2">
        {state === 'CLOCKED_IN' && '🟢 Sedang Bekerja (Sudah Check-In)'}
        {state === 'COMPLETED' && '🎉 Presensi Hari Ini Selesai'}
        {state === 'NOT_CHECKED_IN' && '⚪ Belum Absen Hari Ini'}
      </Text>

      {/* Main Scan Button */}
      <TouchableOpacity
        onPress={handlePressScan}
        disabled={state === 'COMPLETED'}
        className={`py-3 px-6 rounded-lg items-center ${
          state === 'COMPLETED'
            ? 'bg-gray-400'
            : state === 'CLOCKED_IN'
            ? 'bg-amber-500'
            : 'bg-emerald-600'
        }`}
      >
        <Text className="text-white font-bold">
          {state === 'COMPLETED' && 'Presensi Selesai'}
          {state === 'CLOCKED_IN' && 'Scan QR untuk Check-Out'}
          {state === 'NOT_CHECKED_IN' && 'Scan QR untuk Check-In'}
        </Text>
      </TouchableOpacity>
    </View>
  );
}
```

